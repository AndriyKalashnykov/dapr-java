@startuml c4-context
' C4-PlantUML vendored locally under docs/diagrams/C4-PlantUML/ (pinned v2.13.0).
' `make diagrams` passes -DRELATIVE_INCLUDE=. so the vendored files resolve their
' internal !includes locally — NO raw.githubusercontent.com fetch at render time
' (which 429-rate-limits shared CI IPs). A direct `plantuml` render without that
' flag falls back to the remote URL gracefully. Re-vendor: make vendor-diagrams.
!include C4-PlantUML/C4_Context.puml
!include _skinparam.iuml

' Render left-to-right so the 3-element context reads as a landscape hero
' instead of a tall portrait strip (README embeds this as the hero image).
LAYOUT_LEFT_RIGHT()

title System Context — Pizza on Dapr

Person(customer, "Customer", "Places and tracks pizza orders via the web UI")

System(pizza, "Pizza Store Platform", "Orders, cooks, and delivers pizzas; three Spring Boot 4 services collaborating over Dapr building blocks")

' The platform owns its Dapr deployment (Helm-installed control plane + per-pod
' sidecars), so it is modelled as System() rather than System_Ext(). This keeps
' the framing consistent with the Container view, where the sidecar is drawn
' inside the platform's System_Boundary.
System(dapr, "Dapr Runtime", "Sidecar building blocks — service invocation, pub/sub, state store")

Rel(customer, pizza, "Places and tracks orders", "HTTPS / WebSocket")
Rel(pizza, dapr, "Uses building blocks", "HTTP / gRPC on localhost")

SHOW_LEGEND()
@enduml
