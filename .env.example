# .env.example — committed source of truth for operator-tunable values.
#
# Copy to `.env` (gitignored) to override locally; the Makefile `-include .env`
# loads it, and each value has a `?=` default in the Makefile so `.env` is
# optional. Every variable here is a real runtime knob an operator can change
# without editing checked-in YAML. Values coupled to component / k8s manifest
# YAML are intentionally NOT here — see "Excluded (YAML-coupled)" below.

# --- Host ports (fixed binds; guarded by `make check-ports`) ---

# Spring Boot HTTP port bound by `make run` (relaxed-binding: SERVER_PORT ->
# server.port). Override to run alongside another app already on 8080.
SERVER_PORT=8080

# Host-side port for the e2e Jaeger query-API `kubectl port-forward`
# (container port stays 16686). Override so a second concurrent `make e2e`
# run — or a local Jaeger already on 16686 — doesn't collide:
#   make e2e JAEGER_QUERY_PORT=16687
JAEGER_QUERY_PORT=16686

# Port the e2e suite hits on the pizza-store LoadBalancer IP.
GATEWAY_PORT=80

# --- Sidecar ports (test fixtures allocate ephemeral ports; these are the
#     documented defaults the app/sidecar use in a non-test run) ---
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# --- Observability ---

# OTLP/HTTP traces endpoint. Already externalized in each service's
# application.yml as ${MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT:...}.
MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- e2e harness cadence (e2e/e2e-test.sh; tune for slow/fast runners or CI) ---
CURL_MAX_TIME=15
CURL_POLL_MAX_TIME=10
CURL_PROBE_MAX_TIME=3
KUBECTL_WAIT_TIMEOUT=180s
READY_ATTEMPTS=60
POLL_INTERVAL=2
LIFECYCLE_TIMEOUT_SECONDS=150
LIFECYCLE_POLL_INTERVAL=3
WS_KEEPALIVE_SECONDS=25
WS_SETTLE_SECONDS=1
WS_WAIT_ATTEMPTS=25
JAEGER_BIND_ATTEMPTS=10
JAEGER_BIND_INTERVAL=0.5
JAEGER_POLL_ATTEMPTS=20
JAEGER_POLL_INTERVAL=3
JAEGER_TRACE_ATTEMPTS=10

# --- Makefile deploy timeouts / poll cadence (kind-create / kind-deploy / shared) ---
DAPR_HELM_TIMEOUT=5m
ROLLOUT_TIMEOUT=120s
APP_ROLLOUT_TIMEOUT=600s
SHARED_DAPR_TIMEOUT=150s
LB_WAIT_ATTEMPTS=60
LB_WAIT_INTERVAL=2

# --- Excluded (YAML-coupled) — do NOT set here ---
#
# The Dapr building-block identifiers below are read by the app with defaults,
# but they MUST match the Component/Subscription/manifest YAML (metadata.name,
# topic, state-store name, sidecar endpoint). Changing them via env WITHOUT
# editing the coupled YAML silently breaks routing, so they are kept as
# constants (per rules/common/configuration.md "Excluded categories"), not
# presented here as free knobs:
#   PUB_SUB_NAME=pubsub          -> k8s/components-*.yaml pubsub Component name
#   PUB_SUB_TOPIC=topic          -> subscription topic
#   STATE_STORE_NAME=kvstore     -> k8s/components-*.yaml state-store Component name
#   DAPR_HTTP_ENDPOINT=http://localhost:3500  -> sidecar endpoint (manifest-coupled)
